---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry, news } }));
}

const { entry, news } = Astro.props;
const { Content } = await render(entry);
const sortedNews = [...news].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = sortedNews.findIndex((item) => item.id === entry.id);
const previous = sortedNews[currentIndex + 1];
const next = sortedNews[currentIndex - 1];
const related = sortedNews.filter((item) => item.id !== entry.id);
const date = entry.data.date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="breadcrumb shell"><a href={withBase('/')}>首页</a><span>›</span><a href={withBase('/news')}>News</a><span>›</span><span>{entry.data.category}</span></div>
  <article class="article-page">
    <header class="article-header article-width">
      <div class="article-category"><span></span><strong>{entry.data.category}</strong></div>
      <h1>{entry.data.title}</h1>
      <p class="article-lead">{entry.data.description}</p>
      <div class="article-byline"><time>{date}</time><span>作者 · {entry.data.author}</span><span>来源 · {entry.data.source}</span></div>
    </header>
    <div class="article-body article-width">
      {entry.data.cover && (
        <figure class="article-cover">
          <img src={withBase(entry.data.cover)} alt="本届研讨会会场所在的古典图书馆阅览室" />
          <figcaption>图 · 本届研讨会会场所在的古典图书馆阅览室。/ 自强学术促进会</figcaption>
        </figure>
      )}
      <div class="prose"><Content /></div>
      {entry.data.attachment && (
        <aside class="download-card">
          <div class="download-copy"><span class="document-icon">▤</span><div><h2>{entry.data.attachmentLabel}</h2><p>含投稿格式、评议流程与时间表，约 4 页 · 320 KB</p></div></div>
          <a href={withBase(entry.data.attachment)} download>⇩ 下载 PDF</a>
        </aside>
      )}
    </div>
  </article>

  <nav class="article-pagination shell" aria-label="文章翻页">
    <a class:list={[!previous && 'is-disabled']} href={withBase(previous ? `/news/${previous.id}` : '/news')}><span>←</span><small>上一篇</small><strong>{previous?.data.title ?? '返回新闻列表'}</strong></a>
    <a class:list={['next-link', !next && 'is-disabled']} href={withBase(next ? `/news/${next.id}` : '/news')}><span>→</span><small>下一篇</small><strong>{next?.data.title ?? '返回新闻列表'}</strong></a>
  </nav>

  <section class="related-section">
    <div class="shell">
      <div class="section-kicker"><span></span>Related Articles</div>
      <h2>相关文章</h2>
      <div class="news-rows compact">
        {related.map((item) => (
          <a class="news-row" href={withBase(`/news/${item.id}`)}>
            <div class="news-meta"><time>{item.data.date.toISOString().slice(0, 10).replaceAll('-', '.')}</time><span>{item.data.category}</span></div>
            <div><h3>{item.data.title}</h3></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
